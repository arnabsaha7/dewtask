{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TaskNest",
  "version": "../package.json",
  "identifier": "com.tasknest.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TaskNest",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI1OTIxRUU1RjUyRUUwQUMKUldTczRDNzE1UjZTSlZNQ2ZLaFI4NUU4QkJwckh1SVZnU1BaRGRGdzFvZ015M2NwSXN4bHFabDgK",
      "endpoints": [
        "https://github.com/arnabsaha7/tasknest/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
